# ===== «Ұстаз» production баптаулары =====
# Көшіріңіз: cp .env.example .env  — содан кейін барлық CHANGE_ME мәндерін ауыстырыңыз.
# Кездейсоқ мән жасау: openssl rand -hex 32

# Домен (DNS A-жазбасы серверге бағытталған болуы керек)
DOMAIN=ustaz.example.kz
CORS_ORIGIN=https://ustaz.example.kz

# PostgreSQL
POSTGRES_DB=ustaz
POSTGRES_USER=ustaz
POSTGRES_PASSWORD=CHANGE_ME_db_password

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# JWT (кемінде 32 таңба, кездейсоқ)
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32

# ЖСН шифрлау (AES-256-GCM) және іздеу хэші — 64 hex таңба.
# НАЗАР: PII_ENCRYPTION_KEY жоғалса, сақталған ЖСН-дерді ашу мүмкін болмайды. Кілтті бөлек сақтаңыз.
PII_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
PII_HASH_KEY=CHANGE_ME_openssl_rand_hex_32

# Бірінші мектеп (дерекқор бос болса және SEED_DEMO=false болса жасалады)
SCHOOL_NAME=№1 жалпы білім беретін мектеп
SCHOOL_SHORT_NAME=№1 мектеп

# Бірінші жүйе әкімшісі (тек дерекқор бос болғанда жасалады)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_Strong_Pass1
ADMIN_NAME=Жүйе әкімшісі

# Демо деректер: true болса «№1 жалпы білім беретін мектеп» және 200+ оқушы жасалады (бос дерекқорда бір рет).
SEED_DEMO=false
# DEMO_PASSWORD=Ustaz2026!

# Қосымша
APP_TZ=Asia/Almaty
LOG_LEVEL=info
SWAGGER_ENABLED=false          # true болса API құжаттамасы: https://DOMAIN/api/docs
RATE_LIMIT_PER_MIN=300
BACKUP_RETENTION_DAYS=30
RUN_SEED=true
