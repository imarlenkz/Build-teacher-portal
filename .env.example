# ===== «USTAZ» production баптаулары =====
# Көшіріңіз: cp .env.example .env  — содан кейін барлық CHANGE_ME мәндерін ауыстырыңыз.
# Кездейсоқ мән жасау: openssl rand -hex 32

# Домен (DNS A-жазбасы серверге бағытталған болуы керек)
DOMAIN=ustaz.example.kz
CORS_ORIGIN=https://ustaz.example.kz

# PostgreSQL
POSTGRES_DB=ustaz
POSTGRES_USER=ustaz
POSTGRES_PASSWORD=CHANGE_ME_db_password

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# JWT (кемінде 32 таңба, кездейсоқ)
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32

# ЖСН шифрлау (AES-256-GCM) және іздеу хэші — 64 hex таңба.
# НАЗАР: PII_ENCRYPTION_KEY жоғалса, сақталған ЖСН-дерді ашу мүмкін болмайды. Кілтті бөлек сақтаңыз.
PII_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
PII_HASH_KEY=CHANGE_ME_openssl_rand_hex_32

# Nexus (сабақ кестесі жүйесі): мұғалімдер мен кестені импорттау. Кілт Nexus-тегі INTEGRATION_KEY-мен бірдей.
NEXUS_API_URL=https://nexus.imarlen.kz/api
NEXUS_INTEGRATION_KEY=
# Кестені Nexus-тен күн сайын автоматты жаңарту (әдепкі: қосулы, 03:30). Өшіру: NEXUS_AUTO_SYNC=false
# NEXUS_AUTO_SYNC=true
# NEXUS_SYNC_CRON=0 30 3 * * *
# Тестілеу (test.imarlen.kz): тест нәтижелері журналға автоматты түседі. Кілт Тестілеудегі USTAZ_INTEGRATION_KEY-мен бірдей
# (кездейсоқ 32+ таңба: openssl rand -hex 32). Бос болса — қабылдау өшік.
TESTILEU_INTEGRATION_KEY=
# Planit (checker.imarlen.kz): мұғалім оқушыларды Ұстаздан таңдап импорттайды (тек оқу: сынып, аты-жөні, жынысы).
# Кілт Planit-тегі USTAZ_INTEGRATION_KEY-мен бірдей (openssl rand -hex 32). Бос болса — өшік.
PLANIT_INTEGRATION_KEY=

# Бірінші мектеп (дерекқор бос болса және SEED_DEMO=false болса жасалады)
SCHOOL_NAME=№1 жалпы білім беретін мектеп
SCHOOL_SHORT_NAME=№1 мектеп

# Бірінші жүйе әкімшісі (тек дерекқор бос болғанда жасалады)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_Strong_Pass1
ADMIN_NAME=Жүйе әкімшісі

# Демо деректер: true болса «№1 жалпы білім беретін мектеп» және 200+ оқушы жасалады (бос дерекқорда бір рет).
SEED_DEMO=false
# DEMO_PASSWORD=Ustaz2026!

# iMARLEN ID арқылы кіру (OpenID Connect). Үшеуі де толтырылса, кіру бетінде батырма шығады.
# Клиентті id-серверде тіркеу (secret тек бір рет көрсетіледі — осы файлға ғана жазыңыз):
#   docker compose exec id node --disable-warning=ExperimentalWarning src/cli.mjs client ustaz "USTAZ" https://DOMAIN/api/auth/callback https://DOMAIN/ https://DOMAIN/
IID_ISSUER=https://id.imarlen.kz
IID_CLIENT_ID=
IID_CLIENT_SECRET=
# false болса мұғалімдер мен мектеп әкімшілігі тек iMARLEN ID арқылы кіреді (ADMIN құпиясөзбен кіре береді)
IID_PASSWORD_LOGIN=true
# PUBLIC_URL=https://ustaz.example.kz   # әдепкі: https://DOMAIN

# Қосымша
APP_TZ=Asia/Almaty
LOG_LEVEL=info
SWAGGER_ENABLED=false          # true болса API құжаттамасы: https://DOMAIN/api/docs
RATE_LIMIT_PER_MIN=300
BACKUP_RETENTION_DAYS=30
RUN_SEED=true
